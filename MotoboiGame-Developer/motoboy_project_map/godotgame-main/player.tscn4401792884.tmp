[sub_resource type="GDScript" id="GDScript_efrwb"]
script/source = "class_name HurtboxP extends Area2D

func _ready() -> void:
	monitoring = false

	
func receive_hit(damage:int)->void:
	if owner.has_method(\"take_damage\"):
		owner.take_damage(damage)
	else:
		print(\"ERRO: O Dono não tem função\")
"

