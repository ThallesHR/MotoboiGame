[sub_resource type="GDScript" id="GDScript_ajfva"]
script/source = "extends CharacterBody2D

signal healthChange

@export var vida_maxima: int = 5
@onready var vida_atual = vida_maxima
@export var dano: int = 10

var aceleracao: float = 600
var desaceleracao: float = 1000
var velocidade_maxima_x: float = 100

var jump_height: float = 50
var time_apice_pulo: float = 0.3
var pulo_speed: float
var gravidade: float

var is_attacking: bool = false

func _ready():
	pulo_speed = (jump_height * 2) / time_apice_pulo
	gravidade = (jump_height * 2) / pow(time_apice_pulo, 2)
	
	# Inicializa vida_atual com stats.health
	vida_atual = vida_maxima

func _physics_process(delta):
	velocity.y += gravidade * delta
	handle_input(delta)
	move_and_slide()
	update_animations()

func handle_input(delta):
	if is_attacking:
		velocity.x = move_toward(velocity.x, 0, desaceleracao * delta)
		return

	var input_axis = Input.get_axis(\"ui_left\", \"ui_right\")

	if input_axis != 0:
		var target_speed = velocidade_maxima_x
		if Input.is_action_pressed(\"run\"):
			target_speed *= 2
		velocity.x = move_toward(velocity.x, target_speed * input_axis, aceleracao * delta)
	else:
		velocity.x = move_toward(velocity.x, 0, desaceleracao * delta)

	if Input.is_action_just_pressed(\"ui_jump\") and is_on_floor():
		velocity.y = -pulo_speed

	if Input.is_action_just_pressed(\"ui_punch\") and is_on_floor():
		is_attacking = true
		$AnimatedSprite2D.play(\"animation_soco\")

func update_animations():
	if is_attacking:
		return

	if not is_on_floor():
		if velocity.y < 0:
			$AnimatedSprite2D.play(\"animation_jump\")
		else:
			$AnimatedSprite2D.play(\"animation_fall\")
	else:
		var input_axis = Input.get_axis(\"ui_left\", \"ui_right\")
		if input_axis != 0:
			$AnimatedSprite2D.flip_h = (input_axis < 0)
			if abs(velocity.x) > velocidade_maxima_x + 1:
				$AnimatedSprite2D.play(\"animation_run\")
			else:
				$AnimatedSprite2D.play(\"animation_walk\")
		else:
			$AnimatedSprite2D.play(\"idle\")

func _on_animated_sprite_2d_animation_finished():
	if $AnimatedSprite2D.animation == \"animation_soco\":
		is_attacking = false

# === Função take_damage adaptada para atualizar stats.health e vida_atual ===
func take_damage(amount: int):
	vida_atual = clamp(vida_atual - amount, 0, vida_maxima)
	healthChange.emit(vida_atual)
	print(\"Player tomou dano! Vida: \", vida_atual)
	
	if vida_atual <= 0:
		print(\"Player Morreu!\")


func perform_attack():
	var attack_shape = CircleShape2D.new()
	attack_shape.radius = 25
	var attack_lifetime = 0.2

	var hitbox = Hitbox.new()
	hitbox.damage_amount = dano
	hitbox.hitbox_lifetime = attack_lifetime
	hitbox.shape = attack_shape

	hitbox.set_collision_layer_value(4, true)
	hitbox.set_collision_mask_value(6, true)

	var direcao_ataque = -1 if $AnimatedSprite2D.flip_h else 1
	var attack_position = Vector2(30 * direcao_ataque, -5)
	hitbox.global_position = global_position + attack_position

	get_parent().add_child(hitbox)
"

